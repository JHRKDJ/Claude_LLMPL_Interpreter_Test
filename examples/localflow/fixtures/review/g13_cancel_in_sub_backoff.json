{
  "workflow": "g13",
  "cancelAfterMs": 5,
  "workflows": {
    "w": {
      "workflow": "w",
      "jobs": [
        {
          "id": "x",
          "kind": "external",
          "config": {
            "latencyMs": 1,
            "script": [
              "retryable",
              "ok"
            ]
          },
          "retry": {
            "maxAttempts": 2,
            "backoffMs": 10
          }
        },
        {
          "id": "t",
          "kind": "transform",
          "config": {
            "input": "data/words.txt",
            "output": "o.txt",
            "op": "upper",
            "latencyMs": 3
          }
        }
      ]
    }
  },
  "jobs": [
    {
      "id": "s",
      "kind": "subworkflow",
      "retry": {
        "maxAttempts": 2
      },
      "config": {
        "workflow": "w"
      }
    }
  ]
}